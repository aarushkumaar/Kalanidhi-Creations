rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'aarushk0207@gmail.com' ||
        request.auth.token.email == 'kalanidhi.admin@gmail.com'
      );
    }

    // Public read access for pieces, categories, testimonials, and settings
    match /pieces/{pieceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Enquiries: Public can create, Admin can read/update
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
